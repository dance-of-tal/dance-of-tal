{
  "name": "dance-of-tal",
  "version": "3.2.0",
  "description": "Dance of Tal — Agent Manager for Agentic AI. MCP server and CLI for managing AI agent personas, rules, and workflows.",
  "license": "MIT",
  "author": "monarchjuno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dance-of-tal/dance-of-tal.git"
  },
  "homepage": "https://github.com/dance-of-tal/dance-of-tal",
  "bugs": {
    "url": "https://github.com/dance-of-tal/dance-of-tal/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-manager",
    "agentic-ai",
    "persona",
    "prompt-engineering"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/server/index.js",
    "./lib/registry": "./dist/lib/registry.js",
    "./lib/agents": "./dist/lib/agents.js",
    "./lib/installer": "./dist/lib/installer.js",
    "./lib/kinds": "./dist/lib/kinds.js",
    "./data/types": "./dist/data/types.js"
  },
  "bin": {
    "dance-of-tal": "dist/server/index.js",
    "dot": "dist/cli/dot.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsup src/server/index.ts src/cli/dot.ts src/lib/registry.ts src/lib/agents.ts src/lib/installer.ts src/lib/kinds.ts src/data/types.ts --format esm --out-dir dist --dts --clean",
    "release": "npm run build && npm publish",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "prepublishOnly": "npm run build",
    "start": "node dist/server/index.js",
    "cli:dot": "tsx src/cli/dot.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^14.0.3",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "tsup": "8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
