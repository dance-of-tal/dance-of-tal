{
  "name": "dance-of-tal",
  "version": "4.0.5",
  "description": "Dance of Tal — Agent Manager for Agentic AI. CLI for managing AI agent personas, rules, and workflows.",
  "license": "MIT",
  "author": "monarchjuno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dance-of-tal/dance-of-tal.git"
  },
  "homepage": "https://github.com/dance-of-tal/dance-of-tal",
  "bugs": {
    "url": "https://github.com/dance-of-tal/dance-of-tal/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-manager",
    "agentic-ai",
    "persona",
    "prompt-engineering",
    "agent-skills"
  ],
  "type": "module",
  "exports": {
    "./lib/registry": {
      "types": "./dist/lib/registry.d.ts",
      "default": "./dist/lib/registry.js"
    },
    "./lib/registry-api": {
      "types": "./dist/lib/registry-api.d.ts",
      "default": "./dist/lib/registry-api.js"
    },
    "./lib/dependency-resolver": {
      "types": "./dist/lib/dependency-resolver.d.ts",
      "default": "./dist/lib/dependency-resolver.js"
    },
    "./lib/installer": {
      "types": "./dist/lib/installer.d.ts",
      "default": "./dist/lib/installer.js"
    },
    "./lib/publishing": {
      "types": "./dist/lib/publishing.d.ts",
      "default": "./dist/lib/publishing.js"
    },
    "./lib/auth": {
      "types": "./dist/lib/auth.d.ts",
      "default": "./dist/lib/auth.js"
    },
    "./lib/kinds": {
      "types": "./dist/lib/kinds.d.ts",
      "default": "./dist/lib/kinds.js"
    },
    "./data/types": {
      "types": "./dist/data/types.d.ts",
      "default": "./dist/data/types.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./lib/add": {
      "types": "./dist/lib/add.d.ts",
      "default": "./dist/lib/add.js"
    }
  },
  "bin": {
    "dot": "dist/cli/dot.js"
  },
  "scripts": {
    "build": "tsup src/cli/dot.ts src/lib/registry.ts src/lib/registry-api.ts src/lib/dependency-resolver.ts src/lib/installer.ts src/lib/publishing.ts src/lib/auth.ts src/lib/kinds.ts src/lib/add.ts src/data/types.ts src/contracts/index.ts --format esm --out-dir dist --dts --clean",
    "release": "npm run build && npm publish",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "prepublishOnly": "npm run build",
    "cli:dot": "tsx src/cli/dot.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "tsup": "8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
